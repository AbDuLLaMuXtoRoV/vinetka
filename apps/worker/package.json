{
  "name": "@snapbell/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "process-image": "tsx src/cli/process-image.ts"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "3.1160.0",
    "@snapbell/sdk": "workspace:*",
    "bullmq": "5.81.5",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@snapbell/config": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
