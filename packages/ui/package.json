{
  "name": "@snapbell/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Snapbell design system: tokens and React components shared by every web surface.",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    "./styles.css": "./src/styles/tokens.css",
    "./lib/*": "./src/lib/*.ts",
    "./*": "./src/components/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@snapbell/sdk": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.65.0",
    "radix-ui": "1.8.1",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@snapbell/config": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  }
}
