{
  "name": "@snapbell/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations and seed data (PostgreSQL + pgvector).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "prisma generate",
    "generate": "prisma generate",
    "validate": "prisma validate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@snapbell/sdk": "workspace:*"
  },
  "devDependencies": {
    "@snapbell/config": "workspace:*",
    "@types/node": "24.19.2",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
