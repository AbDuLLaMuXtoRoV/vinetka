{
  "name": "snapbell",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @snapbell/db generate",
    "db:migrate": "pnpm --filter @snapbell/db migrate",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "start:all": "node scripts/start.mjs --demo",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "pnpm --filter @snapbell/e2e e2e"
  },
  "devDependencies": {
    "@snapbell/sdk": "workspace:*",
    "@types/node": "24.19.2",
    "prettier": "3.6.2",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
