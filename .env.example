# Snapbell environment variables.
# Nothing here is required for local development: every value has a working
# default and external services fall back to dev simulations.
# The website (apps/web) reads apps/web/.env.local; the API and worker read the process env.

# --- One website: / main site, /shop, /studio, /admin, /v1 API -----------------
API_URL=http://localhost:4000/v1                # server-side API base (the API runs next to the site)
API_ORIGIN=http://127.0.0.1:4000                # where the site forwards /v1/* (next.config rewrite, read at build)
NEXT_PUBLIC_SITE_URL=http://localhost:3000      # the site's public origin
NEXT_PUBLIC_STORE_URL=http://localhost:3000/shop     # Family Store (defaults to <site>/shop)
NEXT_PUBLIC_STUDIO_URL=http://localhost:3000/studio  # Studio app (defaults to <site>/studio)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin    # internal admin (defaults to <site>/admin)
NEXT_PUBLIC_API_URL=/v1                         # API base for anything the browser loads (same origin)

# --- Marketing ----------------------------------------------------------------
NEXT_PUBLIC_CALCOM_URL=                         # Cal.com booking link for /demo; built-in slot picker when empty
NEXT_PUBLIC_CONTACT_PHONE=                      # shown on /contact when set, e.g. +998 71 200 00 00
NEXT_PUBLIC_CONTACT_EMAIL=                      # shown on /contact when set
NEXT_PUBLIC_CONTACT_TELEGRAM=                   # Telegram username (no @) shown on /contact when set

# --- Family Store -------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=             # enables the Stripe Payment Element; "test mode" panel when empty

# --- Studio app ---------------------------------------------------------------
GOOGLE_CLIENT_ID=                               # enables "Continue with Google"

# --- API (apps/api) -----------------------------------------------------------
PORT=4000
AUTH_SECRET=change-me-in-production             # HMAC key for session tokens and signed media URLs (REQUIRED in production)
PUBLIC_API_URL=http://localhost:4000            # origin used in signed media/upload/download URLs (the site's origin in production)
API_PORT=4000                                   # internal API port used by scripts/start.mjs
STORE_URL=http://localhost:3000/shop            # links in texts and emails to parents
STUDIO_URL=http://localhost:3000/studio         # setup and magic links for studio staff
WEB_ORIGINS=http://localhost:3000
TRUST_PROXY=loopback, linklocal, uniquelocal    # who may set X-Forwarded-For (per-IP rate limits)
PROCESSING_DELAY_MS=2000                        # simulated photo processing time when REDIS_URL is unset
UPLOAD_DIR=.data/uploads                        # dev upload sink (S3/R2 presigned URLs in production)
LOG_LEVEL=log
REDIS_URL=                                      # enables BullMQ queues (images, matching, labs, messages)
STRIPE_SECRET_KEY=                              # real PaymentIntents on Connect accounts; simulated when empty
STRIPE_WEBHOOK_SECRET=                          # verifies /v1/webhooks/stripe
TWILIO_ACCOUNT_SID=                             # SMS + Twilio Verify OTP; console + devCode when empty
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM=
POSTMARK_TOKEN=                                 # transactional email; console when empty
EMAIL_FROM=Snapbell <hello@snapbell.com>
LAB_WEBHOOK_SECRET=                             # verifies /v1/webhooks/lab/:lab
SNAPBELL_TEAM_EMAIL=team@snapbell.com           # receives a copy of every contact request
DEMO_MODE=                                      # "true" on the public demo: one-time codes and setup links shown on screen
INTERNAL_PROXY_SECRET=                          # shared with the web apps so per-visitor rate limits work behind proxies

# --- Worker (apps/worker) -----------------------------------------------------
# Uses REDIS_URL, UPLOAD_DIR, TWILIO_*, POSTMARK_TOKEN from above, plus:
DERIVATIVES_DIR=.data/derivatives
WORKER_CONCURRENCY=4
AWS_REGION=                                     # Rekognition face matching; mock matcher when unset
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FACE_RETENTION_DAYS=180                         # biometric data deleted after the season

# --- Database (packages/db) ---------------------------------------------------
DATABASE_URL=postgresql://snapbell:snapbell@localhost:5432/snapbell?schema=public
